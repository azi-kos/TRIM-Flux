<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="sl-SI">
  <!-- Neuradni CSL slog po "Navodilih za izdelavo diplomskega in magistrskega dela" UL FKKT (2024).
       Primer iz navodil:
       [1] M. P. C. Margues, P. Fernandes, J. M. S. Cabral, P. Žnidaršič Plazl, I. Plazl: Continuous steroid
           biotransformations in microchannel reactors. New Biotechnol. 2012, 29, 227–234. DOI: 10.1016/j.nbt.2011.10.001
       Uporaba: Zotero > Nastavitve > Citiranje > "+" in izberi to datoteko. Za kratice revij v Zoteru
       izpolni polje "Journal Abbr" (kratice po CAS Source Index). -->
  <info>
    <title>UL FKKT – diplomsko/magistrsko delo (neuradno)</title>
    <id>http://www.zotero.org/styles/fkkt-ul-neuradno</id>
    <author><name>TRIM-Flux diploma</name></author>
    <category citation-format="numeric"/>
    <category field="chemistry"/>
    <updated>2026-11-10T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name initialize-with=". " delimiter=", " and="text" delimiter-precedes-last="always" name-as-sort-order="none">
        <name-part name="given"/>
      </name>
    </names>
  </macro>
  <macro name="authors-plain">
    <names variable="author">
      <name initialize-with=". " delimiter=", "/>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with=". " delimiter=", "/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="doi">
    <text variable="DOI" prefix="DOI: "/>
  </macro>
  <macro name="pages">
    <text variable="page"/>
  </macro>
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <layout>
      <text variable="citation-number" prefix="[" suffix="] "/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=" ">
            <group delimiter=": ">
              <names variable="author"><name initialize-with=". " delimiter=", "/></names>
              <text variable="title" suffix="."/>
            </group>
            <group delimiter=", " suffix=".">
              <group delimiter=" ">
                <text variable="container-title" form="short" font-style="italic"/>
                <date variable="issued"><date-part name="year"/></date>
              </group>
              <text variable="volume" font-style="italic"/>
              <choose>
                <if variable="page"><text variable="page"/></if>
                <else><text variable="number"/></else>
              </choose>
            </group>
            <text macro="doi"/>
          </group>
        </if>
        <else-if type="book thesis report" match="any">
          <group delimiter=" ">
            <group delimiter=": ">
              <names variable="author"><name initialize-with=". " delimiter=", "/></names>
              <text variable="title" suffix="."/>
            </group>
            <group delimiter=", " suffix=".">
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
              <date variable="issued"><date-part name="year"/></date>
              <text variable="number-of-pages" suffix=" str."/>
            </group>
            <text macro="doi"/>
          </group>
        </else-if>
        <else-if type="chapter paper-conference" match="any">
          <group delimiter=" ">
            <group delimiter=": ">
              <names variable="author"><name initialize-with=". " delimiter=", "/></names>
              <text variable="title" suffix="."/>
            </group>
            <group delimiter=", " suffix=".">
              <text variable="container-title" prefix="V: "/>
              <text variable="edition" suffix=". izd."/>
              <text variable="volume"/>
              <text macro="editor"/>
              <group delimiter=": ">
                <text variable="publisher-place"/>
                <text variable="publisher"/>
              </group>
              <date variable="issued"><date-part name="year"/></date>
              <text variable="page" prefix="str. "/>
            </group>
            <text macro="doi"/>
          </group>
        </else-if>
        <else>
          <group delimiter=" ">
            <group delimiter=": ">
              <names variable="author"><name initialize-with=". " delimiter=", "/></names>
              <text variable="title" suffix="."/>
            </group>
            <group delimiter=", " suffix=".">
              <text variable="container-title"/>
              <text variable="version" prefix="verzija "/>
              <date variable="issued"><date-part name="year"/></date>
            </group>
            <text variable="URL"/>
            <date variable="accessed" prefix="(dostop " suffix=")" form="numeric" date-parts="year-month-day"/>
            <text macro="doi"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
